<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicmanager.view.DashboardController">

    <top>
        <VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #2c3e50; -fx-padding: 20px;">
            <Label text="Catalogo Musicale" textFill="WHITE">
                <font><Font name="System Bold" size="28.0" /></font>
            </Label>
            <Label fx:id="welcomeLabel" text="Caricamento utente..." textFill="#bdc3c7">
                <font><Font size="14.0" /></font>
            </Label>

            <GridPane hgap="10.0" vgap="10.0" alignment="CENTER">
                <TextField fx:id="filterTitolo" promptText="Titolo..." prefWidth="200.0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="filterAutore" promptText="Autore..." prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <TextField fx:id="filterGenere" promptText="Genere..." prefWidth="200.0" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                <TextField fx:id="filterEsecutore" promptText="Esecutore..." prefWidth="200.0" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                <HBox spacing="10.0" alignment="CENTER" GridPane.columnIndex="0" GridPane.rowIndex="1" GridPane.columnSpan="4">
                    <Button minWidth="120.0" onAction="#handleRicerca" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-weight: bold;" text="Applica Filtri" />
                    <Button minWidth="120.0" onAction="#handleReset" style="-fx-background-color: #95a5a6; -fx-text-fill: white;" text="Reset" />
                </HBox>
            </GridPane>

            <HBox alignment="CENTER" spacing="15.0">
                <Button onAction="#handlePlayDiretto" minWidth="150.0" style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;" text="▶️ RIPRODUCI" />
                <Button minWidth="150.0" onAction="#handleMieiContributi" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="🔍 I miei contributi" />
                <Button fx:id="btnAggiungiBrano" managed="false" minWidth="120.0" onAction="#handleAggiungiBrano" style="-fx-background-color: #8e44ad; -fx-text-fill: white; -fx-font-weight: bold;" text="+ Brano" visible="false" />
                <Button fx:id="btnGestioneUtenti" managed="false" minWidth="100.0" onAction="#handleGestioneUtenti" style="-fx-background-color: #d35400; -fx-text-fill: white; -fx-font-weight: bold;" text="⚙️ Utenti" visible="false" />
                <Button fx:id="btnGestioneDizionari" managed="false" minWidth="110.0" onAction="#handleGestioneDizionari" style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-weight: bold;" text="📚 Dizionari" visible="false" />
            </HBox>

            <Label fx:id="errorSearchLabel" textFill="#e74c3c" />
        </VBox>
    </top>

    <center>
        <VBox spacing="8.0" style="-fx-padding: 15px;">
            <TableView fx:id="tabellaBrani" VBox.vgrow="ALWAYS" style="-fx-font-size: 14px;">
                <columns>
                    <TableColumn fx:id="colonnaTitolo" prefWidth="250.0" text="Titolo del Brano" />
                    <TableColumn fx:id="colonnaAutore" prefWidth="150.0" text="Autore Principale" />
                    <TableColumn fx:id="colonnaAnno" prefWidth="80.0" style="-fx-alignment: CENTER;" text="Anno" />
                    <TableColumn fx:id="colonnaProprietario" prefWidth="200.0" text="Caricato da" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" style="-fx-padding: 15px; -fx-background-color: #bdc3c7;">
            <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="Disconnetti (Logout)" />
        </HBox>
    </bottom>
</BorderPane>