<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.musicmanager.view.GestioneUtentiController">
    <top>
        <VBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #d35400; -fx-padding: 15px;">
            <Label text="Gestione Richieste e Account" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </VBox>
    </top>
    <center>
        <TableView fx:id="tabellaUtenti" prefHeight="300.0">
            <columns>
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
                <TableColumn fx:id="colNome" prefWidth="120.0" text="Nome" />
                <TableColumn fx:id="colCognome" prefWidth="120.0" text="Cognome" />
                <TableColumn fx:id="colAttivo" prefWidth="100.0" text="Stato Attivo" />
            </columns>
        </TableView>
    </center>
    <bottom>
        <HBox alignment="CENTER" spacing="20.0" style="-fx-padding: 15px; -fx-background-color: #ecf0f1;">
            <Button onAction="#handleApprova" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold;" text="✅ Approva Utente" />
            <Button onAction="#handleElimina" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold;" text="❌ Elimina Account" />
        </HBox>
    </bottom>
</BorderPane>